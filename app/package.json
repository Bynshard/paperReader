{
  "name": "moonlight-desktop",
  "productName": "Moonlight",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first paper library with layout-preserving translation",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node electron/prepare-ocr.mjs && node electron/dev.cjs",
    "build": "node electron/prepare-ocr.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "smoke": "npm run test",
    "test": "vitest run && node tests/run-node-tests.cjs",
    "bench:browser": "node e2e/benchmark.mjs",
    "package:linux": "npm run build && node electron/package.mjs",
    "package:windows": "npm run build && node electron/package.mjs win32"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.24",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "katex": "0.19.1",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.14",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "katex": "$katex"
  }
}
